# The app's page routes (src/App.tsx), shared by @route (index.html with 200) and @preview (link
# previews for social apps). Keep it in sync with App.tsx and SITEMAP_ROUTES in vite.config.ts;
# tests/test_seo.py checks services/seo.py describes every page here.
(page_routes) {
	path / /fixtures /table /teams /teams/* /matches/* /players/* /my-team /team-of-the-week /players /predictions /insights /gameweek /gameweek/* /glossary /model /assistant /compare /trivia /settings /privacy /terms /contact /stats /design /qa /search
}

# SITE_ADDRESS is a hostname (e.g. 1-2-3-4.sslip.io or fpl.example.com).
# Caddy obtains and renews the HTTPS certificate automatically.
{$SITE_ADDRESS} {
	# Not the assistant's answer stream: server-sent events must reach the browser as they are
	# written, and a compressor can hold them back until its buffer fills
	@compressible not path /api/query/stream
	encode @compressible zstd gzip

	# Link previews. Social apps read a page's Open Graph tags without running JavaScript, so
	# their crawlers would only ever see index.html's site-wide title. Page requests from them
	# go to the backend instead, which answers that page's title, description and image
	# (services/seo.py). The rewrites run before the handle blocks, so these reach @backend.
	# Googlebot isn't listed: it renders the app and reads the tags usePageMeta sets. Only bot
	# names, never an app's own in-app browser ("Pinterest/0" is the crawler, "Pinterest/iOS"
	# the app), or people would get the preview page instead of the site.
	@preview {
		import page_routes
		method GET HEAD
		header_regexp User-Agent (?i)(facebookexternalhit|facebot|twitterbot|whatsapp|slackbot|slack-imgproxy|discordbot|linkedinbot|telegrambot|skypeuripreview|microsoftpreview|pinterestbot|pinterest/0|redditbot|vkshare|embedly|iframely|mastodon|cardyb)
	}
	rewrite @preview /api/seo/preview?path={http.request.uri.path}

	# Club and match pages of the current season, listed by the backend. The build's
	# sitemap.xml is an index of this and sitemap-pages.xml (vite.config.ts).
	rewrite /sitemap-data.xml /api/seo/sitemap.xml

	@backend path /api/* /health /ws /docs /openapi.json
	handle @backend {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv

		# Cache headers, matched on the requested path (before the rewrites below).
		# Vite emits content-hashed filenames under /assets
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# Club crests, icons, the link-preview image and the manifest change rarely and aren't hashed
		@static path /logos/* /favicon.* /apple-touch-icon.png /icon-*.png /og-image.png /site.webmanifest
		header @static Cache-Control "public, max-age=86400"
		# Generated by each build (vite.config.ts). /sitemap-data.xml is the backend's (its own header).
		@seo path /robots.txt /sitemap.xml /sitemap-pages.xml
		header @seo Cache-Control "public, max-age=3600"
		# Everything else is the app's index.html (pages and the 404 page). It names the current
		# build's asset files, so browsers must revalidate it (cheap: ETag -> 304); without a
		# header they cached it heuristically and kept showing the previous build after a deploy.
		@html not path /assets/* /logos/* /favicon.* /apple-touch-icon.png /icon-*.png /og-image.png /site.webmanifest /robots.txt /sitemap.xml /sitemap-pages.xml
		header @html Cache-Control "no-cache"

		# One URL per page: /fixtures/ -> /fixtures
		@trailing path_regexp trailing ^(/.+)/$
		redir @trailing {re.trailing.1}{?query} 308

		# Client-side routes get index.html with 200 (the list is the page_routes snippet at the
		# top). A route missing there still renders in the browser, just with a 404 status, which
		# tells search engines it doesn't exist.
		@route {
			import page_routes
		}
		rewrite @route /index.html

		# Real files: assets, crests, icons, robots.txt, the sitemaps, ...
		@file file
		handle @file {
			file_server
		}

		# Any other URL: index.html, so the app shows its "Page not found" view, with a real 404
		handle {
			rewrite * /index.html
			file_server {
				status 404
			}
		}
	}
}
